# Copy to .env and fill in. Never commit .env.

# Signs access tokens. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Claude API key from console.anthropic.com. Without it, classification and summaries fail.
ANTHROPIC_API_KEY=

# Public URL of the app, used in emailed links.
APP_URL=http://localhost:5173

# Postgres. Leave empty in development to use an embedded database in DATA_DIR.
# Cloud SQL from Cloud Run: postgres://USER:PASSWORD@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=
# Connections per instance; keep instances × this below the database's limit.
DB_POOL_MAX=10
# Apply migrations at start-up. Set to false when a separate job runs them.
RUN_MIGRATIONS=true
# Used by docker-compose for its Postgres container.
POSTGRES_PASSWORD=

# Uploaded photos, kernel crops and the embedded database.
DATA_DIR=./data
# Google Cloud Storage bucket for photos and crops (required on Cloud Run). Empty = DATA_DIR.
STORAGE_BUCKET=
STORAGE_PREFIX=

# Email for verification, password reset and invites, e.g. smtps://user:pass@smtp.example.com
# Without it, emails are written to the server log.
SMTP_URL=
MAIL_FROM=AI-Grain <no-reply@example.com>

# Default model: claude-sonnet-5-5 (default), claude-haiku-5-5 (lowest cost) or claude-opus-5-5 (difficult samples).
DEFAULT_MODEL=claude-sonnet-5-5

# Set to false to allow new accounts only through invites.
ALLOW_SIGNUP=true
# Set to true to require a confirmed email address before sign-in.
REQUIRE_EMAIL_VERIFICATION=false
