{
  "name": "@ai-grain/api",
  "version": "0.1.0",
  "description": "AI-Grain HTTP API: auth, samples, imaging, Claude classification, weighing and reports",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-grain/core": "*",
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.13",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@google-cloud/storage": "^8.4.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "jose": "^6.2.14",
    "nodemailer": "^10.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
